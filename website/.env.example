# All of these are baked into the static build, so set them on the host
# (Render → bakeops-site → Environment) before building. None are secrets.

# Production API; the tracking page reads order status from it.
NEXT_PUBLIC_API_URL=https://bakeops-api-njig.onrender.com

# Latest Android APK (from the EAS build, see issue #26). Leave empty until
# the first build exists: the Download page then shows "coming soon".
NEXT_PUBLIC_APK_URL=

# Contact details shown on the Contact page and footer.
# WhatsApp number in international format without "+" or spaces, e.g. 919822041556
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=
