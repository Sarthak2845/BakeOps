# Base URL of the BakeOps backend API.
# Android emulator: use http://10.0.2.2:4000 instead of localhost.
# Physical device: use your machine's LAN IP, e.g. http://192.168.1.23:4000.
EXPO_PUBLIC_API_URL=http://localhost:4000

# The public website; customer tracking links are <site>/track/<shop>/<order>.
EXPO_PUBLIC_SITE_URL=https://bakeops.sarthak-rana.me

# Business logo upload (Cloudinary). Create an *unsigned* upload preset in the
# Cloudinary dashboard (Settings -> Upload -> Upload presets), limited to a
# folder such as bakeops-logos, images only, with a max file size.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
