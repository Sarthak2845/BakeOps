generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  STAFF
}

enum OrderStatus {
  INQUIRY
  CONFIRMED
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model Business {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  category        String?
  logoUrl         String?
  address         String?
  phone           String?
  email           String?
  gstin           String?
  currency        String   @default("INR")
  timezone        String   @default("Asia/Kolkata")
  plan            String   @default("free")
  invoiceSequence Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users     User[]
  customers Customer[]
  orders    Order[]
  invoices  Invoice[]
}

model User {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String
  email      String?
  address    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business  Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  occasions CustomerOccasion[]
  orders    Order[]

  @@unique([businessId, phone])
  @@index([businessId])
}

model CustomerOccasion {
  id         String   @id @default(cuid())
  customerId String
  label      String
  month      Int
  day        Int
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Order {
  id            String      @id @default(cuid())
  businessId    String
  customerId    String
  orderDate     DateTime    @default(now())
  deliveryDate  DateTime?
  status        OrderStatus @default(INQUIRY)
  occasionTag   String?
  advancePaid   Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal     @default(0) @db.Decimal(12, 2)
  balanceDue    Decimal     @default(0) @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  invoice  Invoice?

  @@index([businessId])
  @@index([businessId, status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @default(0) @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Invoice {
  id            String        @id @default(cuid())
  businessId    String
  orderId       String        @unique
  invoiceNumber String
  issuedDate    DateTime      @default(now())
  pdfUrl        String?
  paymentStatus PaymentStatus @default(UNPAID)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Decimal  @db.Decimal(12, 2)
  method    String?
  paidAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
