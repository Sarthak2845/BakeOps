# Postgres connection string from Supabase or Neon (free tier is fine).
# Supabase: Project Settings -> Database -> Connection string (URI, "Transaction" pooler works for dev).
# Neon: dashboard -> Connection Details -> Connection string.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

PORT=4000

# Logging (all optional)
# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent. Default: info (silent under Jest).
#   "debug" adds a line per DB operation and per incoming request.
# LOG_LEVEL=info
# LOG_PRETTY: "true" for colorized human-readable output, "false" for JSON lines.
#   Default: pretty when NODE_ENV=development in an interactive terminal, JSON otherwise.
# LOG_PRETTY=false
# DB operations slower than this (ms) are logged at warn level.
# LOG_SLOW_QUERY_MS=500
