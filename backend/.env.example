# Postgres connection string from Supabase or Neon (free tier is fine).
# Supabase: Project Settings -> Database -> Connection string (URI, "Transaction" pooler works for dev).
# Neon: dashboard -> Connection Details -> Connection string.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

PORT=4000
